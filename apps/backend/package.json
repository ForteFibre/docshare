{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "openapi:generate": "tsc -p tsconfig.build.json >/dev/null && node scripts/generate-openapi.mjs && pnpm exec biome format --write openapi.json",
    "openapi:print": "tsc -p tsconfig.build.json >/dev/null && node scripts/generate-openapi.mjs --stdout",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:runtime": "node dist/db/migrate.js",
    "legacy:migrate": "tsx src/scripts/migrate-legacy-docshare.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@hono/node-server": "^1.13.8",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "@sendgrid/mail": "^8.1.5",
    "better-auth": "^1.7.20",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "nodemailer": "^8.0.5",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
